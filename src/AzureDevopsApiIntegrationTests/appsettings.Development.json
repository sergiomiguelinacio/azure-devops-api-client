{
  "AzureDevOps": {
    "Organization": "your-dev-organization",
    "PersonalAccessToken": "your-dev-pat-token",
    "TestProject": "your-dev-test-project"
  },
  "IntegrationTests": {
    "Enabled": true,
    "SkipRealApiCalls": false,
    "TimeoutSeconds": 60,
    "MaxRetries": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "System.Net.Http.HttpClient": "Debug"
    }
  }
}
