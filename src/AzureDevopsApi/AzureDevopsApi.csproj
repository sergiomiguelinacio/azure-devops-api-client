<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>AzureDevOpsApi</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Version>1.0.0</Version>
    <Authors>Sergio</Authors>
    <Company>DevOps Solutions</Company>
    <Product>Azure DevOps API Client</Product>
    <Description>A comprehensive .NET client library for Azure DevOps REST API with built-in retry policies, circuit breakers, and resilience patterns using Polly. Supports all major Azure DevOps operations including projects, teams, work items, repositories, and more.</Description>
    <PackageTags>azure-devops;api-client;rest-api;polly;resilience;retry;circuit-breaker;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/sergio/AzureDevOpsApi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sergio/AzureDevOpsApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Initial release with support for Azure DevOps Core API operations including Teams, Operations, and TeamMembersWithExtendedProperties.</PackageReleaseNotes>
    <Copyright>Copyright © 2025 Sergio</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- Include Examples in NuGet Package -->
  <ItemGroup>
    <None Include="../Examples/**/*.cs" Pack="true" PackagePath="content/Examples/" />
    <None Include="../Examples/**/*.json" Pack="true" PackagePath="content/Examples/" />
    <None Include="../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Polly" Version="8.4.2" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApiBase/ApiBase.csproj" />
  </ItemGroup>



</Project>
